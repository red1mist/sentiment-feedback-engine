# Optional. Run with:  .venv/bin/uvicorn app.main:app --env-file .env
# Every value has a development default; APP_ENV=production refuses the default secrets.

APP_ENV=dev
DATABASE_PATH=feedback.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_SECONDS=3600
ADMIN_API_KEY=change-me-admin-key
DEFAULT_RATE_LIMIT_PER_MINUTE=60
TOKEN_ENDPOINT_LIMIT_PER_MINUTE=10

SENTIMENT_BACKEND=vader            # vader | transformers
